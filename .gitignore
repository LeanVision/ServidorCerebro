# Modelos locales grandes: se descargan o distribuyen fuera de Git.
demografia.onnx

# Credenciales locales (Supabase, etc.). Nunca subir.
.env

# Config del plano (cámaras/zonas): específica de cada despliegue físico.
plano_config.json
plano_imagen.jpg

# Instalador local, no forma parte del repositorio.
Claude Setup.exe

# Artefactos de Python.
__pycache__/
*.pyc

# Cola de salida del outbox. Por defecto vive FUERA del repo (../estado/),
# porque cerebro-autopull hace git pull acá cada 5 minutos. Esto es por si
# alguien la mueve adentro con LEANVISION_OUTBOX_DB.
*.db
*.db-wal
*.db-shm
estado/
